! -----------------------------------------------------------------------------
! File: spaceduck-light.xresources
! Description: An intergalactic space theme for Vim, Terminal, and more!
! Based: https://github.com/spaceduck-theme/
! -----------------------------------------------------------------------------

! =========================
! Base colors
! =========================
#define BACKGROUND #f0f1ce
#define FOREGROUND #0f111b

! =========================
! Black + DarkGrey
! =========================
#define COLOR0  #2b2e44
#define COLOR8  #3e4055

! =========================
! DarkRed + Red
! =========================
#define COLOR1  #e33400
#define COLOR9  #c72d00

! =========================
! DarkGreen + Green
! =========================
#define COLOR2  #00a370
#define COLOR10 #008c5e

! =========================
! DarkYellow + Yellow
! =========================
#define COLOR3  #8e7dc6
#define COLOR11 #7a68b0

! =========================
! DarkBlue + Blue
! =========================
#define COLOR4  #0088aa
#define COLOR12 #006f8c

! =========================
! DarkMagenta + Magenta
! =========================
#define COLOR5  #c9a800
#define COLOR13 #a88b00

! =========================
! DarkCyan + Cyan
! =========================
#define COLOR6  #6347aa
#define COLOR14 #523a8e

! =========================
! LightGrey + White
! =========================
#define COLOR7  #3e4055
#define COLOR15 #ffffff

! =========================
! Global assignments
! =========================
*.background:   BACKGROUND
*.foreground:   FOREGROUND
*.cursorColor:  FOREGROUND

! black
*.color0:       COLOR0
*.color8:       COLOR8

! red
*.color1:       COLOR1
*.color9:       COLOR9

! green
*.color2:       COLOR2
*.color10:      COLOR10

! yellow
*.color3:       COLOR3
*.color11:      COLOR11

! blue
*.color4:       COLOR4
*.color12:      COLOR12

! magenta
*.color5:       COLOR5
*.color13:      COLOR13

! cyan
*.color6:       COLOR6
*.color14:      COLOR14

! white
*.color7:       COLOR7
*.color15:      COLOR15

! vim: ft=xdefaults sw=2 ts=2 sts=2 et tw=80
