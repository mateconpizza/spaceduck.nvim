! -----------------------------------------------------------------------------
! File: spaceduck-dark.xresources
! Description: An intergalactic space theme for Vim, Terminal, and more!
! Based: https://github.com/spaceduck-theme/
! -----------------------------------------------------------------------------

! =========================
! Base colors
! =========================
#define BACKGROUND #0f111b
#define FOREGROUND #ecf0c1

! =========================
! Black + DarkGrey
! =========================
#define COLOR0  #000000
#define COLOR8  #686f9a

! =========================
! DarkRed + Red
! =========================
#define COLOR1  #e33400
#define COLOR9  #e33400

! =========================
! DarkGreen + Green
! =========================
#define COLOR2  #5ccc96
#define COLOR10 #5ccc96

! =========================
! DarkYellow + Yellow
! =========================
#define COLOR3  #b3a1e6
#define COLOR11 #b3a1e6

! =========================
! DarkBlue + Blue
! =========================
#define COLOR4  #00a3cc
#define COLOR12 #00a3cc

! =========================
! DarkMagenta + Magenta
! =========================
#define COLOR5  #f2ce00
#define COLOR13 #f2ce00

! =========================
! DarkCyan + Cyan
! =========================
#define COLOR6  #7a5ccc
#define COLOR14 #7a5ccc

! =========================
! LightGrey + White
! =========================
#define COLOR7  #686f9a
#define COLOR15 #f0f1ce

! =========================
! Global assignments
! =========================
*.background:   BACKGROUND
*.foreground:   FOREGROUND
*.cursorColor:  FOREGROUND

! black
*.color0:       COLOR0
*.color8:       COLOR8

! red
*.color1:       COLOR1
*.color9:       COLOR9

! green
*.color2:       COLOR2
*.color10:      COLOR10

! yellow
*.color3:       COLOR3
*.color11:      COLOR11

! blue
*.color4:       COLOR4
*.color12:      COLOR12

! magenta
*.color5:       COLOR5
*.color13:      COLOR13

! cyan
*.color6:       COLOR6
*.color14:      COLOR14

! white
*.color7:       COLOR7
*.color15:      COLOR15

! vim: ft=xdefaults sw=2 ts=2 sts=2 et tw=80
