[urgency_low]
    background  = "#f0f1ce"
    foreground  = "#0f111b"
    frame_color = "#c6cfed"
    timeout     = 5

[urgency_normal]
    background  = "#f0f1ce"
    foreground  = "#0f111b"
    highlight   = "#7a68b0"
    timeout     = 5

[urgency_critical]
    background  = "#c72d00"
    foreground  = "#ffffff"
    frame_color = "#c72d00"
    timeout     = 0
