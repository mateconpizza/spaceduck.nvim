# Newsboat colour scheme for Spaceduck Light theme

# color   <element>       <foreground>    <background> <attribute>
color   background          color0        default
color   listnormal          color0        default        dim
color   listnormal_unread   color4        default
color   listfocus           color15       color14        dim
color   listfocus_unread    color15       color14        bold
color   info                color8        default
color   article             color0        default

color   title               color0        default        bold
color   hint-key            color6        default        bold
color   hint-keys-delimiter color8        default
color   hint-separator      color8        default        bold
color   hint-description    color8        default        dim
color   end-of-text-marker  color8        default

# subheadings
highlight feedlist "╼.*"    color14      default        bold

# highlights
#                                           <foreground>  <background> <attribute>
highlight article "^(Feed|Link):.*$"          color11     default     bold
highlight article "^(Title|Date|Author):.*$"  color11     default     bold
highlight article "https?://[^ ]+"            color2      default     underline
highlight article "\\[[0-9]+\\]"              color2      default     bold
highlight article "\\[image\\ [0-9]+\\]"      color2      default     bold
highlight feedlist "^─.*$"                    color4      color4      bold
