<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>spaceduck-light</string>

  <key>settings</key>
  <array>

    <!-- === Global UI === -->
    <dict>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#30365f</string> <!-- dark_purple (was greyer) -->
        <key>background</key>
        <string>#f0f1ce</string> <!-- cream (was blackish) -->
        <key>caret</key>
        <string>#0f111b</string> <!-- blackish (was cream) -->
        <key>invisibles</key>
        <string>#818596</string> <!-- grey -->
        <key>gutterForeground</key>
        <string>#686f9a</string> <!-- grey_purple -->
        <key>gutterForegroundHighlight</key>
        <string>#00a370</string> <!-- green (darkened) -->
        <key>lineHighlight</key>
        <string>#e8e9d8</string> <!-- light variant of dark_blue -->
        <key>selection</key>
        <string>#dfe0c9</string> <!-- light grey (was dark_purple) -->
        <key>selectionBorder</key>
        <string>#c1c3cc</string>
        <key>activeGuide</key>
        <string>#c67d00</string> <!-- orange (darkened) -->
        <key>findHighlightForeground</key>
        <string>#0f111b</string>
        <key>findHighlight</key>
        <string>#c9a800</string> <!-- yellow (darkened) -->
        <key>bracketsForeground</key>
        <string>#686f9a</string>
        <key>bracketContentsForeground</key>
        <string>#686f9a</string>
      </dict>
    </dict>

    <!-- === Syntax === -->
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#818596</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#00a370</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>String regex</string>
      <key>scope</key><string>string.regexp</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#c67d00</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Number</string>
      <key>scope</key><string>constant.numeric</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#c67d00</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Boolean</string>
      <key>scope</key><string>constant.language.boolean</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#c67d00</string>
        <key>fontStyle</key><string>bold italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Built-in constant</string>
      <key>scope</key><string>constant.language</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#8e7dc6</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#c72d00</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Conditional / Loop</string>
      <key>scope</key><string>keyword.control.loop, keyword.control.conditional</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#6347aa</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Operator</string>
      <key>scope</key><string>keyword.operator, punctuation.accessor</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#0088aa</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Function name</string>
      <key>scope</key><string>entity.name.function, variable.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#0088aa</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Type / Class</string>
      <key>scope</key><string>entity.name.class, support.type</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#686f9a</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Variable</string>
      <key>scope</key><string>variable</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#30365f</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#f0f1ce</string>
        <key>background</key><string>#c72d00</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Diff inserted</string>
      <key>scope</key><string>markup.inserted</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#00a370</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Diff deleted</string>
      <key>scope</key><string>markup.deleted</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#c72d00</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Diff changed</string>
      <key>scope</key><string>markup.changed</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#c9a800</string>
      </dict>
    </dict>

  </array>

  <key>colorSpaceName</key>
  <string>sRGB</string>
  <key>semanticClass</key>
  <string>theme.light.Spaceduck</string>
  <key>author</key>
  <string>generated</string>
</dict>
</plist>
